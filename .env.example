# Copy to .env and adjust as needed. All values have dev-safe defaults in
# docker-compose.yml, so the stack runs without a .env file.

# --- Postgres ---
# Host port 5433 (5432 used by local nexus-postgres)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres

# --- PostgREST ---
PGRST_JWT_SECRET=dev-jwt-secret-dev-only-0123456789abcdef

# --- API (Supabase-compatible env) ---
SUPABASE_ANON_KEY=anon-dev-key
SUPABASE_SERVICE_ROLE_KEY=service-dev-key
API_AUTH_TOKEN=
INTERNAL_TOKEN=dev-internal-token

# --- Worker / WhatsApp ---
# Comma-separated phone_number_id:number pairs, e.g. 1001:628123456789,1002:628987654321
WABA_DEVICES=
BUSINESS_ACCOUNT_ID=
SUPABASE_DSN=
WHATSMEOW_STORE_DSN=
MIGRATIONS_DIR=../../shared/db/migrations
POLL_INTERVAL=1s
MAX_ATTEMPTS=3
API_URL=http://localhost:3000
INTERNAL_TOKEN=dev-internal-token
WEBHOOK_CONFIG_TTL=30s
