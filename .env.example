# Copy to .env and adjust as needed. All values have dev-safe defaults in
# docker-compose.yml, so the stack runs without a .env file.

# --- Postgres ---
# Host port 5433 (5432 used by local nexus-postgres)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres

# --- API (Dashboard Route Handlers) ---
# Direct Postgres connection string (replaces PostgREST).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/waba
# Bearer token required for API routes.
API_AUTH_TOKEN=kosong
# Bearer token required for internal routes (worker ↔ API).
INTERNAL_TOKEN=dev-internal-token
# Max time (ms) to wait for a send job to complete. Default: 25000.
SEND_TIMEOUT_MS=25000
# Poll interval (ms) between job status checks. Default: 250.
RESULT_POLL_MS=250
# Heartbeat TTL (ms). Default: 30000.
HEARTBEAT_TTL_MS=30000
# Base64 32-byte key for AES-256-GCM encryption of API-key secrets at rest.
API_KEY_ENCRYPTION_KEY=
# Previous key during rotation (only needed while rotating; reveal still works for old ciphertexts).
API_KEY_ENCRYPTION_KEY_PREVIOUS=

# --- Dashboard (Next.js client) ---
# When set, the dashboard always sends `Authorization: Bearer <token>`.
# When unset/blank, Basic mode: on the first 401 the dashboard prompts for the
# API_AUTH_TOKEN value and caches a Basic header in sessionStorage.
NEXT_PUBLIC_API_TOKEN=

# --- Worker / WhatsApp ---
# Devices are provisioned from the sessions table; no static device list here.
BUSINESS_ACCOUNT_ID=
DATABASE_URL=postgres://postgres:postgres@localhost:5433/waba
WHATSMEOW_STORE_DSN=
MIGRATIONS_DIR=../../shared/db/migrations
POLL_INTERVAL=1s
MAX_ATTEMPTS=3
API_URL=http://localhost:3002
WEBHOOK_CONFIG_TTL=30s
HEARTBEAT_INTERVAL=10s
