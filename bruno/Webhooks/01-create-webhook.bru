meta {
  name: Create Webhook Config
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/webhooks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{api_token}}
  Content-Type: application/json
}

body:json {
  {
    "phone_number_id": "{{webhook_phone_number_id}}",
    "webhook_url": "https://example.com/hooks/waba"
  }
}
