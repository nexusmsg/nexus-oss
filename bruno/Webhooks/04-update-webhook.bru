meta {
  name: Update Webhook Config
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/webhooks/{{webhook_serial}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{api_token}}
  Content-Type: application/json
}

body:json {
  {
    "enabled": false,
    "max_retries": 5,
    "retry_delay_ms": 2000,
    "timeout_ms": 15000
  }
}
