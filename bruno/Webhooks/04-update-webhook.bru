meta {
  name: Update Webhook Config
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/webhooks/{{webhook_serial}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{api_token}}
  Content-Type: application/json
}

body:json {
  {
      "webhook_url": "http://host.docker.internal:8787/hook"
  }
}
