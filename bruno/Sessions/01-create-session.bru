meta {
  name: Create Session
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/sessions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{api_token}}
  Content-Type: application/json
}

body:json {
  {
    "phone_number_id": "{{phone_number_id}}",
    "number": "{{number}}"
  }
}
