# Copy to .env and adjust as needed. The dashboard (Next.js) loads this file
# from its own directory — values here are for the API + management UI.

# --- Database ---
# Direct Postgres connection string (used by the Drizzle transport).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/waba

# --- Auth ---
# Bearer token required for /api/v1/*. Management routes (api-keys) are
# bootstrap-only; persisted keys can never call them. Empty closes all routes.
API_AUTH_TOKEN=kosong
# Bearer token for /api/internal/* (worker <-> API). Empty disables them (401).
INTERNAL_TOKEN=dev-internal-token
# When set, the dashboard always sends `Authorization: Bearer <token>`.
# When unset/blank, it prompts for the API_AUTH_TOKEN value on first 401.
NEXT_PUBLIC_API_TOKEN=

# --- API keys at rest ---
# Base64 32-byte AES-256-GCM key for API-key secrets (key_ciphertext).
# Required for key create/reveal; the api-keys feature fails closed without it.
# Generate: openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=
# Previous key during rotation (reads only) — keeps reveal working for
# ciphertexts written with the old key; drop it once rotation completes.
API_KEY_ENCRYPTION_KEY_PREVIOUS=
# Environment label embedded in key prefixes (waba_<env>_...); defaults to
# NODE_ENV -> "dev".
API_KEY_ENV=

# --- Behavior ---
# Max ms to wait for a send job terminal state. Default: 25000.
SEND_TIMEOUT_MS=25000
# Delay between job status polls. Default: 250.
RESULT_POLL_MS=250
# Worker heartbeat TTL (ms). Default: 30000.
HEARTBEAT_TTL_MS=30000
# Comma-separated allow-list of origins allowed to call /api/v1/* cross-origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
