{
  "name": "internal webhook-config ok",
  "request": {
    "method": "GET",
    "urlPath": "/internal/webhook-config",
    "queryParameters": {
      "phone_number_id": {
        "equalTo": "phone-itest-500"
      }
    },
    "headers": {
      "Authorization": {
        "equalTo": "Bearer itest-token"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "webhook-config-ok.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
